{
  "schema": "ghrab-data-manifest-v1",
  "appId": "activity-builder",
  "appVersion": "0.5.19",
  "manifestVersion": 6,
  "dataCategories": [
    "settings",
    "application-content",
    "diagnostics",
    "ai-prompts-and-results"
  ],
  "privacy": {
    "studentContentMayOccur": true,
    "telemetryContainsContent": false,
    "diagnosticsContainContentByDefault": false,
    "pseudonymisationIsNotAnonymisation": true
  },
  "stores": [
    {
      "kind": "localStorage",
      "category": "application-data",
      "patterns": [
        "ghrab.activity-builder.*"
      ],
      "sensitivity": "potentially-personal",
      "authority": "client",
      "clearOnEndWork": true
    },
    {
      "kind": "sessionStorage",
      "category": "session-data",
      "patterns": [
        "ghrab.activity-builder.gemini.key.session"
      ],
      "sensitivity": "confidential",
      "authority": "client",
      "clearOnEndWork": true
    },
    {
      "kind": "localStorage",
      "category": "credential",
      "patterns": [
        "ghrab.activity-builder.gemini.key.permanent",
        "ghrab.activity-builder.gemini.key.session"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "sessionStorage",
      "category": "credential",
      "patterns": [
        "ghrab.activity-builder.gemini.key.permanent",
        "ghrab.activity-builder.gemini.key.session"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "indexedDB",
      "category": "application-data",
      "names": [
        "activa-library-v1"
      ],
      "sensitivity": "potentially-personal",
      "authority": "client",
      "clearOnEndWork": true
    },
    {
      "kind": "cacheStorage",
      "category": "application-cache",
      "patterns": [
        "ghrab-activity-builder-v*",
        "activity-builder*"
      ],
      "sensitivity": "non-content-cache",
      "authority": "client",
      "clearOnEndWork": false
    },
    {
      "kind": "localStorage",
      "category": "shared-platform-handoff",
      "patterns": [
        "ghrab.platform.handoff.v2",
        "ghrab.handoff.v1",
        "ghrab.pilot.events.v2"
      ],
      "sensitivity": "potentially-personal",
      "authority": "shared-platform",
      "clearOnEndWork": true,
      "clearScope": "only valid packets/events targeted to activity-builder; other application data is preserved",
      "malformedDataPolicy": "application-owned data is deleted independently; malformed or targetless shared records are preserved and reported to the user"
    }
  ],
  "retention": {
    "mode": "user-controlled",
    "automaticClientExpiryDays": null,
    "serverLogsDays": null,
    "note": "Serverless klient neprovádí automatické časové mazání. Lokální data se mažou výslovnou akcí Ukončit práci; sessionStorage končí s relací prohlížeče.",
    "sessionStorageEndsWithBrowserSession": true
  },
  "export": {
    "supported": true,
    "requiresExplicitUserAction": true,
    "includesSecrets": false,
    "envelopeSchema": "ghrab-artifact-envelope-v1",
    "artifactTypes": [
      "activa-project",
      "activa-library",
      "activa-material",
      "activa-share",
      "activa-school-candidate"
    ],
    "nativeFormats": [
      "html",
      "pdf",
      "docx",
      "json"
    ]
  },
  "deletion": {
    "supported": true,
    "clientVerified": false,
    "clientControl": "window.ACTIVA_END_WORK()",
    "serverEndpoint": null,
    "note": "Produkční profil je serverless; serverové mazání není připojeno. Vlastní data ACTIVA se mažou nezávisle na sdílených platformních klíčích. Neparsovatelný nebo bezcílový cizí handoff/event zůstane zachován a uživatel dostane pravdivé upozornění na částečný úklid sdílené vrstvy.",
    "clientPropertyTested": true,
    "browserLifecycleVerified": false
  },
  "sharedDevice": {
    "supported": true,
    "defaultInSchoolProfile": true,
    "control": "window.ACTIVA_END_WORK()"
  },
  "storageNamespace": {
    "schema": "ghrab-storage-namespace-v1",
    "prefix": "ghrab.activity-builder.",
    "migrationId": "p2-storage-namespace-v1",
    "backup": "full",
    "rollbackSupported": true
  },
  "import": {
    "supported": true,
    "artifactTypes": [
      "activa-project",
      "activa-library",
      "activa-material",
      "activa-share"
    ],
    "acceptsLegacyJson": true,
    "checksumRequiredForEnvelope": true
  }
}
